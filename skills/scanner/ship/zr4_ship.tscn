[gd_scene format=3]

; КОРАБЕЛЬ ZR4 із гри (content/entities/ships/zr4_fighter), без ігрової обв'язки:
; лишився корпус з тим самим матеріалом і трьома соплами на jet.gdshader. Сліди
; двигунів (engine_trail) і ship_visual.gd не перенесено: вони тягнуть за собою
; польотну модель і мережу, а для стенду сканера корабель лише стоїть поруч.
;
; Масштаб корпусу той самий, що в грі (0.009637): ZR4 нормалізований до
; ShipModels.TARGET_LENGTH = 3.82 юніта, тож поруч із купою він такого ж розміру,
; як у секторі.

[ext_resource type="ArrayMesh" path="res://skills/scanner/ship/mesh/SF_Fighter-ZR4.obj" id="1_mesh"]
[ext_resource type="Material" path="res://skills/scanner/ship/mesh/zr4_material.tres" id="2_mat"]
[ext_resource type="Shader" path="res://skills/scanner/ship/jet/jet.gdshader" id="3_jet"]
[ext_resource type="Script" path="res://skills/scanner/ship/jet/jet_thrust.gd" id="4_thrust"]

