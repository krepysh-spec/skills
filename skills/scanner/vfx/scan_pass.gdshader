shader_type spatial;
render_mode unshaded, blend_add, cull_back, depth_draw_never, shadows_disabled;

// ПРОМІНЬ АНАЛІЗУ, ЩО ПОВЗЕ ПО САМОМУ КОРПУСУ. Смуга йде знизу вгору по
// предмету, який сканують: у ній горить заливка, по ній біжать тонкі лінії, її
// верхній край — гаряча нитка, а силует у смузі спалахує на просвіт. Позаду
// лишається згасаючий слід — те, що вже прочитали.
//
// НАДЯГАЄТЬСЯ ПОВЕРХ, А НЕ ЗАМІСТЬ. Матеріал ставиться в `material_overlay`
// меша (див. scan_pass.gd), тобто предмет малюється своїм матеріалом, як і
// малювався, а цей шейдер додає другий прохід тією самою геометрією. Тому тут
// немає ні albedo, ні normal, ні metallic: нічого не треба переносити, нема чого
// губити при поверненні, і ящик під час скану виглядає ящиком, а не голограмою
// себе. (Порівняй із materialise.gd, який саме ЗАМІНЯЄ матеріал і тому мусить
// тягнути за собою всі карти поверхні.)
//
// ЧОМУ СМУГА, А НЕ ДИСК. Доти прохід малювався окремим диском у світі —
// циліндр, що їхав крізь предмет. Диск живе СВОЇМ життям: він однакового
// розміру хоч на кубі, хоч на двадцятиюнітовій купі уламків, він стирчить
// краями за силует, а на тонкій деталі його просто не видно. Смуга ж не має
// власної геометрії взагалі — вона малюється рівно там, де є корпус, тож
// обмальовує будь-яку модель за її формою і нічого не вигадує довкола.
//
// ВЕДЕТЬСЯ У СВІТОВИХ КООРДИНАТАХ (`band_y`), а не в модельних, і це головне:
// моделі тут приходять із чужими масштабами (у куба 0.0017 на корені й ~100
// всередині), а купа уламків — це взагалі сорок окремих вузлів зі своїми
// поворотами. Світовий y — єдина висота, однакова для всіх них, тому смуга йде
// по купі ОДНІЄЮ лінією, а не сорока різними.

// ------------------------------------------------------------------ СМУГА

// Висота смуги в СВІТІ. Її веде scan_pass.gd від низу габариту до верху.
uniform float band_y = 0.0;
// Півтовщина смуги і довжина сліду позаду неї, у світових одиницях. Обидва
// числа ставить scan_pass.gd від РОЗМІРУ предмета: смуга сталої товщини на
// кубі в два юніти і на купі в двадцять — це два різні ефекти.
uniform float band_half = 0.35;
uniform float trail_len = 1.2;
// Наскільки яскравий слід проти самої смуги.
uniform float trail_level : hint_range(0.0, 1.0) = 0.22;
// Товщина гарячої нитки на передньому краї.
uniform float lip_half = 0.05;

// Загальна сила ефекту, 0..1 — нею ефект запалюється і гасне.
uniform float fade : hint_range(0.0, 1.0) = 1.0;

// -------------------------------------------------------------- КОЛЬОРИ

uniform vec4 tint_color : source_color = vec4(0.22, 0.62, 1.0, 1.0);
uniform vec4 edge_color : source_color = vec4(0.75, 0.95, 1.0, 1.0);
uniform float intensity : hint_range(0.0, 4.0) = 1.0;

// Спалах силуету: чим гостріше поверхня відвернута від камери, тим яскравіше
// вона світиться. Саме це робить смугу ОБ'ЄМНОЮ — без нього вона читається
// наліпкою на передній грані.
uniform float rim_power : hint_range(0.5, 8.0) = 2.6;
uniform float rim_level : hint_range(0.0, 3.0) = 1.1;

// --------------------------------------------------------------- ЛІНІЇ

// Скільки ліній на світову одиницю висоти. Ставиться від розміру предмета, щоб
// на кубі їх було видно поштучно, а на купі вони не злилися в сірість.
uniform float line_density = 26.0;
uniform float line_thickness : hint_range(0.0, 1.0) = 0.45;
uniform float line_level : hint_range(0.0, 1.0) = 0.55;
// Лінії біжать УНИЗ, назустріч ходу смуги: так рух читається як робота
// приладу, а не як те, що смугу тягне разом із малюнком.
uniform float line_speed = -1.6;

// --------------------------------------------------------------- ЗБІЙ

// Перешкоди в смузі, 0 — вимкнено: горизонтальні стрічки, у яких лінії
// збиваються з фази, а заливка блимає. Читається як прилад, що ловить сигнал.
//
// ЦЕ ФРАГМЕНТНИЙ ЕФЕКТ, І НАВМИСНО. Спокуса зробити збій зсувом ВЕРШИН
// (класичний RGB-tear) тут не працює: накладка ділить геометрію з корпусом під
// нею, і зсунуті вершини поїхали б повз власну модель — вийшов би не збій
// картинки, а друга напівпрозора копія предмета поруч із ним. Заразом це
// економить `inverse(MODEL_MATRIX)` на кожну вершину, бо зсув довелося б
// рахувати у світі й переводити назад.
uniform float glitch : hint_range(0.0, 1.0) = 0.0;
// Висота однієї стрічки збою у світових одиницях.
uniform float glitch_band = 0.25;
uniform float glitch_speed = 9.0;

varying vec3 world_pos;

float hash11(float x) {
	return fract(sin(x * 127.1) * 43758.5453);
}

// Наскільки ця точка всередині смуги. > 0 — попереду смуги (ще не дійшла),
// < 0 — позаду (уже пройшла).
float band_delta(vec3 p) {
	return p.y - band_y;
}

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	float d = band_delta(world_pos);

	// Попереду смуги немає нічого: предмет ще не читали.
	if (d > band_half) {
		discard;
	}
	// ...і позаду теж, щойно слід вичерпався.
	if (d < -(band_half + trail_len)) {
		discard;
	}

	// ТІЛО СМУГИ: м'яко гасне до обох країв.
	float body = 1.0 - smoothstep(0.0, band_half, abs(d));
	// СЛІД: рівна тьмяна заливка позаду, що тане на довжині trail_len.
	float trail = 0.0;
	if (d < 0.0) {
		trail = (1.0 - smoothstep(band_half, band_half + trail_len, -d)) * trail_level;
	}
	float mask = max(body, trail);

	// ГАРЯЧА НИТКА на самому передньому краї. Вона одна робить зі смуги «щось,
	// що їде», а не «щось, що світиться»: око чіпляється за різкий край.
	float lip = 1.0 - smoothstep(0.0, max(lip_half, 0.0001), abs(d - band_half));

	// ЗБІЙ, якщо його ввімкнули: стрічка збиває фазу ліній і притлумлює
	// заливку. Рахується до ліній, бо саме їх він і зсуває.
	float phase = 0.0;
	float flicker = 1.0;
	if (glitch > 0.0) {
		float strip = floor(world_pos.y / max(glitch_band, 0.001));
		float t = floor(TIME * glitch_speed);
		float k = hash11(strip + t * 7.3);
		phase = (k - 0.5) * glitch * 2.0;
		flicker = mix(1.0, step(0.25, k), glitch);
	}

	// ЛІНІЇ поперек ходу, у світовій висоті — тому на купі з сорока шматків
	// вони стоять однією сіткою, а не сорока незалежними.
	float ln = fract(world_pos.y * line_density + TIME * line_speed + phase);
	float line = smoothstep(0.5 - line_thickness * 0.5, 0.5, abs(ln - 0.5));

	// СИЛУЕТ. NORMAL і VIEW тут у просторі виду, чого для френеля досить.
	float rim = pow(clamp(1.0 - abs(dot(normalize(NORMAL), normalize(VIEW))), 0.0, 1.0), rim_power);

	// ЛІНІЇ ЖИВУТЬ ТІЛЬКИ В САМІЙ СМУЗІ, а слід за нею — рівне тихе світіння.
	// Спершу лінії йшли по всьому, включно зі слідом, і прочитане позаду
	// виходило таким самим строкатим, як те, що читають зараз: з боку це два
	// однакові шуми, а не робота і її результат.
	vec3 col = tint_color.rgb * body * mix(1.0, line, line_level);
	// ...і ядро смуги трохи гарячіше за її краї, щоб вона мала середину.
	col += tint_color.rgb * body * body * 0.45;
	col += tint_color.rgb * trail;
	col += tint_color.rgb * rim * rim_level * mask;
	col += edge_color.rgb * lip * 1.6;

	// blend_add множить ALBEDO на ALPHA, тож усе складено наперед, а ALPHA
	// лишається одиницею: інакше довелося б зводити чотири різні прозорості
	// (тіло, слід, нитка, силует) до одного числа й кожна з них зіпсувала б
	// решту.
	ALBEDO = col * intensity * fade * tint_color.a * flicker;
	ALPHA = 1.0;
}
